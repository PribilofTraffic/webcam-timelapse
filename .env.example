# Settings for the webcam-timelapse container. Copy the lines you need into
# the .env beside your docker-compose.yml.

# --- required -----------------------------------------------------------------
# Where the camera serves one JPEG per request. Capture is off while empty.
WEBCAM_URL=http://<your camera>/snapshot.jpg

# Folders on this machine (inside the container they are always /data,
# /config, /frames, /videos, /share and /backups).
WEBCAM_DATA_DIR=./webcam_timelapse/data
WEBCAM_CONFIG_DIR=./webcam_timelapse/config
WEBCAM_FRAMES_DIR=./webcam_timelapse/frames
WEBCAM_VIDEO_DIR=./webcam_timelapse/videos

# The user the container runs as; it must be able to write the folders above.
WEBCAM_UID=1000
WEBCAM_GID=1000

# --- optional -----------------------------------------------------------------
# One HTML page per video, for sharing a day. Off while empty.
WEBCAM_SHARE_DIR=
# Dated copies of the index database. Off while empty.
WEBCAM_BACKUP_DIR=
WEBCAM_BACKUP_KEEP=3
# Match this to the container's cpus limit (see README, "Speed").
WEBCAM_FFMPEG_THREADS=4
# Days of frames to keep. Videos are kept for good.
WEBCAM_RETENTION_DAYS=30
# 1 = the clean-up reports what it would delete and deletes nothing.
WEBCAM_CLEANUP_DRY_RUN=
# Override the site file: "civil" or "sun", and minutes added at both ends.
WEBCAM_DAYLIGHT_MODE=
WEBCAM_DAYLIGHT_MARGIN_MIN=
